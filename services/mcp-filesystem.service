[Unit]
Description=MCP Filesystem Server
After=network.target

[Service]
Type=simple
User=mcp
Group=mcp
WorkingDirectory=/opt/mcp/http
Environment="HOST=0.0.0.0"
Environment="PORT=9001"
Environment="MCP_THREADS_ROOT=/srv/ai-share"
Environment="MCP_LOG_DIR=/var/log/mcp"
LogsDirectory=mcp
Environment="MCP_HTTP_ACCESS_LOG_NAME=http-access"
ExecStart=/opt/mcp/http/venv/bin/python /opt/mcp/http/fs_server.py
Restart=always
RestartSec=3
##ReadWritePaths=/var/log/mcp /srv/ai-share
UMask=0027

[Install]
WantedBy=multi-user.target
